# Copy to backend/.env (git-ignored) for local runs. Never commit the real file.
# Everything is optional: with nothing set, the app uses an in-memory database and in-memory seat holds.

# Postgres, e.g. Neon's connection string (postgresql://user:password@host/db?sslmode=require)
DATABASE_URL=
# Redis, e.g. Upstash's address (rediss://default:password@host:6379)
REDIS_URL=
# The page allowed to call the API (comma-separated; wildcards like https://*.vercel.app work)
FRONTEND_ORIGIN=http://localhost:5173
